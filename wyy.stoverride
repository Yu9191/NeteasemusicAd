name: '网易云音乐去广告'
desc: |-
  全面净化 - 自定义 Tab 名称
  侧边栏「去广告设置」可在 App 内直接修改设置
author: 'Yu9191[https://github.com/Yu9191]'
homepage: 'https://github.com/Yu9191/NeteasemusicAd'
icon: 'https://raw.githubusercontent.com/Keywos/rule/main/tv/app/144px/Netease.png'
category: '网易云音乐'
date: '2026-11-25'

rules:
  - DOMAIN,iadmusicmat.music.126.net,REJECT
  - DOMAIN,iadmat.nosdn.127.net,REJECT
  - DOMAIN,iadmatapk.nosdn.127.net,REJECT
  - DOMAIN,httpdns.n.netease.com,REJECT
  - DOMAIN,httpdns.music.163.com,REJECT

http:
  mitm:
    - music.163.com
    - interface.music.163.com
    - interface3.music.163.com
    - interface9.music.163.com
    - httpdns.n.netease.com
    - ipv4.music.163.com
  url-rewrite:
    - '^https?:\/\/(ipv4|interface\d?)\.music\.163.com\/x?e?api\/ad - reject-dict'
    - '^https?:\/\/interface\d?\.music\.163\.com\/[wx]?e?api\/(?:side-bar\/mini-program\/music-service\/account|delivery\/(batch-deliver|deliver)|moment\/tab\/info\/get|yunbei\/account\/entrance\/get) - reject-dict'
    - '^https?:\/\/music\.163\.com\/x?eapi\/delivery\/(batch-deliver|deliver) - reject-dict'
    - '^https?:\/\/interface\d?\.music\.163\.com\/x?eapi\/(?:resource\/comments?\/musiciansaid|community\/friends\/fans-group\/artist\/group\/get|user\/sub\/artist|music\/songshare\/text\/recommend\/get|mine\/applet\/redpoint|resniche\/position\/play\/new\/get) - reject-dict'
    - '^https?:\/\/interface\d?\.music\.163.com\/[wx]?e?api\/search\/default - reject-dict'
    - '^https?:\/\/interface\d?\.music\.163.com\/[wx]?e?api\/(?:search\/(chart|rcmd\/keyword|specialkeyword)|resource-exposure\/|activity\/bonus\/playpage\/time\/query) - reject-dict'
    - '^https?:\/\/interface\d?\.music\.163.com\/x?eapi\/(?:mlivestream\/entrance\/playpage|link\/(position\/show\/strategy|scene\/show)|ios\/version|v\d\/content\/exposure\/comment\/banner) - reject-dict'
    - '^https?:\/\/interface\d?\.music\.163\.com\/store\/x?e?api\/(webconfig|entryconfig) - reject-dict'
  script:
    - match: '^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/(batch|v\d\/resource\/comment\/floor\/get|v1\/user\/info|resource\/comments\/reply\/preload|comment\/feed\/inserted\/resources\/combined)'
      name: 网易云音乐去广告
      type: response
      require-body: true
      binary-mode: true
      max-size: 10485760
      timeout: 20
    - match: '^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/sp\/flow\/popup\/query'
      name: 网易云音乐去广告
      type: response
      require-body: true
      binary-mode: true
      max-size: 10485760
      timeout: 20
    - match: '^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/home\/framework\/tab'
      name: 网易云音乐去广告
      type: response
      require-body: true
      binary-mode: true
      max-size: 10485760
      timeout: 20
      argument: 'FX=0&MY=1&DT=0&GZ=1&SOU=1&SY_NAME=0&WD_NAME=0&MY_NAME=0&DT_NAME=0&FX_NAME=0'
    - match: '^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/home\/framework\/top\/tab'
      name: 网易云音乐去广告
      type: response
      require-body: true
      binary-mode: true
      max-size: 10485760
      timeout: 20
      argument: 'XD=1&YY=0&BK=0&TS=0&HDTAB=0'
    - match: '^https?:\/\/((ipv4|interface\d?)\.)?music\.163\.com\/x?e?api\/vipactivity\/app\/cashier\/setting\/get'
      name: 网易云音乐去广告
      type: response
      require-body: true
      binary-mode: true
      max-size: 10485760
      timeout: 20
    - match: '^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/(homepage\/block\/page|link\/page\/rcmd\/(resource\/show|block\/resource\/multi\/refresh))'
      name: 网易云音乐去广告
      type: response
      require-body: true
      binary-mode: true
      max-size: 10485760
      timeout: 20
      argument: 'PRGG=0&PRDRD=0&PRSCVPT=0&PRST=0&HMPR=0&PRRR=1&PRRK=0&PRMST=0&PRCN=1&PRPRS=1&PRRSS=1'
    - match: '^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/page\/discovery\/resource\/show'
      name: 网易云音乐去广告
      type: response
      require-body: true
      binary-mode: true
      max-size: 10485760
      timeout: 20
    - match: '^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/link\/position\/show\/resource'
      name: 网易云音乐去广告
      type: response
      require-body: true
      binary-mode: true
      max-size: 10485760
      timeout: 20
    - match: '^https?:\/\/(ipv4|interface\d?)\.music\.163\.com\/x?e?api\/user\/follow\/users\/mixed\/get'
      name: 网易云音乐去广告
      type: response
      require-body: true
      binary-mode: true
      max-size: 10485760
      timeout: 20
    - match: '^https?:\/\/music\.163\.com\/wyy-settings'
      name: 网易云音乐去广告
      type: request
      timeout: 20

script-providers:
  网易云音乐去广告:
    url: https://raw.githubusercontent.com/Yu9191/NeteasemusicAd/main/wyyad.js
    interval: 86400
